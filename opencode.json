{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["vercel"],
  "model": "vercel/deepseek/deepseek-v4-flash-0731",
  "agent": {
    "research": {
      "model": "vercel/deepseek/deepseek-v4-flash-0731",
      "mode": "primary",
      "steps": 8,
      "permission": {
        "read": { "*": "deny", "raw.md": "allow", "public/images/manifest.json": "allow" },
        "edit": { "*": "deny", "proof.md": "allow" },
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny"
      }
    },
    "build": {
      "model": "vercel/openai/gpt-5.6-sol",
      "mode": "primary",
      "steps": 12,
      "permission": {
        "read": {
          "*": "deny",
          "proof.md": "allow",
          ".redesign/build-images.json": "allow",
          ".redesign/relume-candidates.json": "allow",
          "package.json": "allow",
          "app/page.tsx": "allow",
          "app/globals.css": "allow",
          "app/layout.tsx": "allow"
        },
        "edit": {
          "*": "deny",
          "app/page.tsx": "allow",
          "app/globals.css": "allow",
          "app/layout.tsx": "allow"
        },
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "relume-library_list_categories": "allow",
        "relume-library_search_components": "allow",
        "relume-library_list_components": "allow",
        "relume-library_get_components": "allow",
        "relume-library_get_component": "deny",
        "relume-library_get_primitives": "deny",
        "relume-library_get_setup_instructions": "deny"
      }
    },
    "repair": {
      "model": "vercel/deepseek/deepseek-v4-flash-0731",
      "mode": "primary",
      "steps": 6,
      "permission": {
        "read": {
          "*": "deny",
          "package.json": "allow",
          "app/page.tsx": "allow",
          "app/globals.css": "allow",
          "app/layout.tsx": "allow"
        },
        "edit": {
          "*": "deny",
          "app/page.tsx": "allow",
          "app/globals.css": "allow",
          "app/layout.tsx": "allow"
        },
        "glob": "deny",
        "grep": "deny",
        "list": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "relume-library_*": "deny"
      }
    }
  },
  "provider": {
    "vercel": {
      "npm": "@ai-sdk/gateway",
      "env": ["AI_GATEWAY_API_KEY"],
      "options": { "apiKey": "{env:AI_GATEWAY_API_KEY}" },
      "models": {
        "deepseek/deepseek-v4-flash-0731": {},
        "openai/gpt-5.6-sol": {}
      }
    }
  },
  "mcp": {
    "relume-library": {
      "type": "remote",
      "url": "https://relume-library-mcp.relume.io/mcp",
      "enabled": true
    }
  }
}
